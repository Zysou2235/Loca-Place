# ---------------------------------------------------------------------------
# Variables d'environnement — AdGuard Home sur Railway
#
# Local   : cp .env.example .env, puis renseignez au minimum ADMIN_PASSWORD.
# Railway : recopiez ces variables dans l'onglet « Variables » du service.
#           Ne commitez JAMAIS votre .env (il est déjà dans .gitignore).
# ---------------------------------------------------------------------------

# === Obligatoire : accès à l'interface d'administration ====================
# L'interface est publique (URL Railway en HTTPS) : sans mot de passe, elle
# serait ouverte à tous. Le conteneur refuse donc de démarrer sans l'une des
# deux variables ci-dessous.

# Option A (recommandée) — hash bcrypt, généré chez vous :
#   ./scripts/hash-password.sh
# Le mot de passe en clair n'apparaît alors nulle part dans Railway.
# Attention : dans un fichier .env, écrivez la valeur ENTRE APOSTROPHES,
# sinon les $ du hash peuvent être interprétés.
#ADMIN_PASSWORD_HASH='$2y$10$remplacez-moi-par-un-vrai-hash-bcrypt'

# Option B (plus simple) — mot de passe en clair, haché au démarrage.
# Reste lisible par toute personne ayant accès au projet Railway.
ADMIN_PASSWORD=changez-moi-vraiment

# Nom d'utilisateur de l'interface.
ADMIN_USER=admin

# Passez à true UNE FOIS pour réécrire l'utilisateur et le mot de passe d'une
# installation existante (mot de passe oublié). Repassez à false ensuite,
# sinon toute modification faite depuis l'interface sera écrasée à chaque
# redémarrage.
RESET_ADMIN_PASSWORD=false

# === Sécurité du point d'accès DNS ========================================
# TRÈS IMPORTANT. Liste des ClientID autorisés, séparés par des virgules.
# Chaque appareil interroge alors https://<domaine>/dns-query/<clientid>.
#
#  - liste VIDE   -> résolveur ouvert : n'importe qui connaissant l'URL peut
#                    s'en servir (et vous en supporterez le coût) ;
#  - liste REMPLIE-> AdGuard refuse toute requête sans ClientID connu, et
#                    l'historique est ventilé par appareil.
#
# Format d'un ClientID : lettres minuscules, chiffres et tirets (pas de « _ »,
# pas d'accent, pas de point), 63 caractères maximum.
# Ces identifiants ne sont pas des secrets solides, mais ils sont difficiles à
# deviner s'ils ne sont pas triviaux : évitez « pc », préférez « pc-papa-7fa3 ».
ALLOWED_CLIENT_IDS=

# === Résolveurs en amont ==================================================
# Séparés par des virgules. Par défaut Quad9 (filtre déjà les domaines
# malveillants) et Cloudflare, tous deux en DNS-over-HTTPS.
# Autres choix courants :
#   https://dns.google/dns-query
#   https://dns0.eu/                    (résolveur européen)
#   https://doh.mullvad.net/dns-query
UPSTREAM_DNS=https://dns.quad9.net/dns-query,https://dns.cloudflare.com/dns-query

# === Historique ===========================================================
# Durée de conservation du journal des requêtes et des statistiques.
# Valeurs proposées par l'interface : 6h, 24h, 168h (7 j), 720h (30 j),
# 2160h (90 j). Comptez environ 25 à 60 Mo par tranche de 100 000 requêtes.
# Une famille de 4 personnes génère typiquement 50 000 à 150 000 requêtes/jour :
# 30 jours tiennent large dans un volume de 5 Go, 90 jours beaucoup moins.
QUERYLOG_RETENTION=720h
STATS_RETENTION=720h

# === Réglages réseau ======================================================
# Requêtes par seconde et par IP cliente. Toute la maison partage une seule IP
# publique : ne descendez pas trop bas. 0 = pas de limite (déconseillé si
# ALLOWED_CLIENT_IDS est vide).
RATELIMIT=60

# Proxies de confiance pour lire l'en-tête X-Forwarded-For. Sur Railway, le
# proxy d'entrée est le seul chemin vers le port HTTP du conteneur : lui faire
# confiance permet de voir la vraie IP publique de la maison dans l'historique
# plutôt que celle du proxy. En local, mettez 127.0.0.0/8,::1/128.
TRUSTED_PROXIES=0.0.0.0/0,::/0

# Port du DNS « classique » (UDP/TCP) à l'intérieur du conteneur. Injoignable
# depuis Internet sur Railway (pas d'UDP) ; on garde un port non privilégié
# pour ne dépendre d'aucune capacité particulière. En local : 53.
PLAIN_DNS_PORT=5353

# Fuseau horaire, utilisé pour les horodatages et les plannings de blocage.
TZ=Europe/Paris

# === Sauvegardes (optionnel) ==============================================
# Archive conf/ + historique dans <volume>/backups, via le cron interne.
# À lire : ces archives vivent sur LE MÊME volume que les données. Voir la
# section « Sauvegardes » du README pour les récupérer hors site.
BACKUP_ENABLED=false
BACKUP_CRON=17 4 * * *
BACKUP_KEEP=14

# === Divers ===============================================================
# Railway injecte PORT automatiquement : ne le définissez pas ici en production.
#PORT=3000

# Emplacement des données. Sur Railway, laissez vide : la valeur est déduite
# de RAILWAY_VOLUME_MOUNT_PATH (le point de montage de votre volume).
#DATA_DIR=/data
