{
  "name": "@carnet/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "start": "node dist/index.js",
    "worker": "node dist/jobs/worker-cli.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node --experimental-strip-types prisma/seed-demo.ts"
  },
  "dependencies": {
    "@carnet/shared": "*",
    "@fastify/cors": "11.3.0",
    "@fastify/rate-limit": "11.2.0",
    "@prisma/client": "7.10.0",
    "fastify": "5.12.4",
    "jose": "6.2.12",
    "pdfkit": "0.20.2",
    "pino": "10.3.1",
    "zod": "4.6.5",
    "@prisma/adapter-pg": "7.10.0",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pdfkit": "0.17.6",
    "prisma": "7.10.0",
    "@types/pg": "8.23.1"
  }
}
