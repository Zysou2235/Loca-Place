# Configuration Carnet Artisan — copier en .env et renseigner.
# Ce fichier ne contient AUCUN secret réel et ne doit jamais en contenir.

# --- Serveur ---------------------------------------------------------------
NODE_ENV=development
PORT=3001
HOTE=0.0.0.0
# URL publique du serveur, utilisée pour construire les URL de webhook.
URL_PUBLIQUE=http://localhost:3001

# --- Base de données -------------------------------------------------------
DATABASE_URL=postgresql://carnet:carnet@127.0.0.1:5432/carnet_dev

# --- Secrets obligatoires --------------------------------------------------
# JWT_SECRET : 32 caractères minimum.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=a-remplacer-par-une-valeur-aleatoire-de-48-octets
DUREE_JETON_MINUTES=20160

# CHIFFREMENT_CLE : 32 octets encodés en base64. Chiffre les secrets
# fournisseur au repos. La perdre rend ces secrets illisibles.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CHIFFREMENT_CLE=a-remplacer-par-32-octets-en-base64

# --- Téléphonie ------------------------------------------------------------
# demo : aucun service externe n'est contacté.
# zadarma : exige les deux clés ci-dessous, sinon le serveur refuse de démarrer.
TELEPHONIE_FOURNISSEUR=demo
ZADARMA_CLE_REVENDEUR=
ZADARMA_SECRET_REVENDEUR=

# --- Transcription ---------------------------------------------------------
# demo | externe (API compatible OpenAPI /v1/audio/transcriptions)
TRANSCRIPTION_FOURNISSEUR=demo
TRANSCRIPTION_URL=
TRANSCRIPTION_CLE=
TRANSCRIPTION_MODELE=whisper-1

# --- Analyse ---------------------------------------------------------------
# demo | anthropic
IA_FOURNISSEUR=demo
IA_CLE=
IA_MODELE=claude-sonnet-5
IA_URL=https://api.anthropic.com

# --- Stockage privé --------------------------------------------------------
STOCKAGE_CHEMIN=./donnees-privees

# --- Téléchargement des enregistrements (protection SSRF) ------------------
# Liste blanche stricte : tout domaine absent d'ici est refusé.
AUDIO_DOMAINES_AUTORISES=zadarma.com,api.zadarma.com
AUDIO_TAILLE_MAX_OCTETS=83886080
AUDIO_DUREE_MAX_SECONDES=7200
AUDIO_TIMEOUT_MS=30000

# --- Tarifs (millièmes d'euro) ---------------------------------------------
# Tous à zéro tant qu'aucun tarif réel n'est connu. Voir docs/06.
# Ne PAS inventer de valeurs : un modèle de coûts faux est pire qu'absent.
COUT_TELEPHONIE_MILLIEMES_PAR_MINUTE=0
COUT_TRANSCRIPTION_MILLIEMES_PAR_MINUTE=0
COUT_IA_MILLIEMES_PAR_ANALYSE=0
COUT_STOCKAGE_MILLIEMES_PAR_GO_MOIS=0
COUTS_SOURCE=non renseigne
COUTS_DATE=non renseignee
